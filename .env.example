# Supabase project for the ERP (use a SEPARATE project from the website/CRM)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Needed for: parent pages (/p/...), creating staff logins. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Public URL of this app (used in parent links and WhatsApp messages)
NEXT_PUBLIC_APP_URL=https://erp.codersduniya.com
# Optional branding
NEXT_PUBLIC_PRODUCT_NAME=CodersDuniya School ERP
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional fallback: CodersDuniya's own Razorpay keys. Better: save them in Super Admin → Settings → Integrations (encrypted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Protects /api/cron/billing (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# Encrypts integration keys (Razorpay, Cloudinary, SMTP, MSG91, WhatsApp) saved in the Settings centre.
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it casually — changing it makes saved keys unreadable (they must be re-entered).
SETTINGS_ENCRYPTION_KEY=
